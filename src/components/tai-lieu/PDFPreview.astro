---
export interface PDFFile {
  url: string;
  label: string;
  tabLabel?: string; // Optional shorter label for tabs
}

export interface Props {
  downloadUrl?: string;
  title?: string;
  height?: string;
  width?: string;
  class?: string;
  // For multiple files
  files?: PDFFile[];
  defaultIndex?: number;
}

const { 
  downloadUrl, 
  title = "PDF Preview",
  height = "600px",
  width = "100%",
  class: className = '',
  files = [],
  defaultIndex = 0
} = Astro.props;

// Support both single file and multiple files
const hasMultipleFiles = files.length > 0;
const singleFileUrl = downloadUrl || '';

// Function to convert Google Drive download URL to preview URL
function convertToPreviewUrl(url: string): string {
  try {
    // Handle Google Drive URLs
    if (url.includes('drive.google.com')) {
      // Extract file ID from various Google Drive URL formats
      let fileId = '';
      
      // Format 1: https://drive.google.com/open?id=FILE_ID&usp=drive_fs
      if (url.includes('open?id=')) {
        const match = url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
        if (match) fileId = match[1];
      }
      
      // Format 2: https://drive.google.com/file/d/FILE_ID/view
      if (url.includes('/file/d/')) {
        const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
        if (match) fileId = match[1];
      }
      
      // Format 3: https://docs.google.com/document/d/FILE_ID/edit
      if (url.includes('/document/d/')) {
        const match = url.match(/\/document\/d\/([a-zA-Z0-9_-]+)/);
        if (match) fileId = match[1];
      }
      
      if (fileId) {
        return `https://drive.google.com/file/d/${fileId}/preview`;
      }
    }
    
    // If not a Google Drive URL or couldn't extract ID, return original
    return url;
  } catch (error) {
    console.error('Error converting URL to preview format:', error);
    return url;
  }
}

// Handle multiple files or single file
const previewFiles = hasMultipleFiles 
  ? files.map(file => ({
      ...file,
      previewUrl: convertToPreviewUrl(file.url)
    }))
  : [];

const previewUrl = hasMultipleFiles 
  ? null 
  : convertToPreviewUrl(singleFileUrl);
  
const isValidUrl = hasMultipleFiles 
  ? previewFiles.length > 0 
  : (previewUrl && previewUrl.startsWith('http'));
---

<div class={`pdf-preview-container ${className}`}>
  {isValidUrl ? (
    hasMultipleFiles ? (
      <!-- Multiple files with tabs -->
      <div class="pdf-frame-card">
        <!-- Tabs Navigation -->
        <div class="pdf-tabs">
          <div class="pdf-tab-list">
            {previewFiles.map((file, index) => (
              <button
                type="button"
                class={`pdf-tab-btn ${index === defaultIndex ? 'active' : ''}`}
                data-tab-index={index}
                data-pdf-url={file.previewUrl}
                data-download-url={file.url}
              >
                {file.tabLabel || file.label}
              </button>
            ))}
          </div>
        </div>

        <!-- PDF Preview Container -->
          <div class="pdf-iframe-wrapper">
          {previewFiles.map((file, index) => (
            <div
              class={`pdf-preview-panel ${index === defaultIndex ? 'active' : 'hidden'}`}
              data-panel-index={index}
            >
              <div class="pdf-panel-header">
                <div>
                  <h3>
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path>
                    </svg>
                    Xem trước: {file.label}
                  </h3>
                  <p>
                    Xem trước tài liệu PDF trực tiếp trên trình duyệt
                  </p>
                </div>
                <a 
                  href={file.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pdf-open-link"
                >
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Mở trong tab mới
                </a>
              </div>
              
              <iframe 
                src={file.previewUrl}
                width="100%"
                height={height}
                allow="autoplay"
                loading={index === defaultIndex ? "eager" : "lazy"}
                class="pdf-iframe"
                title={`PDF Preview: ${file.label}`}
                data-src={file.previewUrl}
              ></iframe>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <!-- Single file -->
      <div class="pdf-frame-card">
        <div class="pdf-panel-header">
          <div>
            <h3>
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path>
              </svg>
              {title}
            </h3>
            <p>
              Xem trước tài liệu PDF trực tiếp trên trình duyệt
            </p>
          </div>
          <a 
            href={downloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="pdf-open-link"
          >
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Mở trong tab mới
          </a>
        </div>
        
        <div class="pdf-iframe-wrapper">
          <iframe 
            src={previewUrl}
            width={width}
            height={height}
            allow="autoplay"
            loading="lazy"
            class="pdf-iframe"
            title={`PDF Preview: ${title}`}
          ></iframe>
        </div>
      </div>
    )
  ) : (
    <!-- Error state -->
    <div class="pdf-error-card">
      <div class="pdf-error-content">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <h3>Lỗi hiển thị PDF</h3>
          <p>
            {hasMultipleFiles 
              ? 'Không có file để xem trước. Vui lòng thêm ít nhất một file PDF.' 
              : 'Không thể hiển thị bản xem trước. Vui lòng sử dụng link tải xuống.'}
          </p>
        </div>
      </div>
    </div>
  )}
</div>

<script>
  // Tab switching functionality for multiple files
  if (document.querySelector('.pdf-tab-btn')) {
    document.addEventListener('DOMContentLoaded', () => {
      const tabButtons = document.querySelectorAll('.pdf-tab-btn');
      const pdfPanels = document.querySelectorAll('.pdf-preview-panel');
      
      tabButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          // Remove active class from all tabs and panels
          tabButtons.forEach(btn => btn.classList.remove('active'));
          
          pdfPanels.forEach(panel => {
            panel.classList.remove('active');
            panel.classList.add('hidden');
          });
          
          // Add active class to clicked tab and corresponding panel
          button.classList.add('active');
          
          const panel = pdfPanels[index];
          if (panel) {
            panel.classList.remove('hidden');
            panel.classList.add('active');
            
            // Lazy load iframe if not loaded yet
            const iframe = panel.querySelector('.pdf-iframe');
            if (iframe && !iframe.src) {
              const src = iframe.getAttribute('data-src');
              if (src) {
                iframe.src = src;
              }
            }
          }
        });
      });
    });
  }
</script>

<style>
  .pdf-preview-container { margin-bottom: 1.5rem; }
  .pdf-frame-card {
    overflow: hidden;
    margin-bottom: 1.5rem;
    border: 1px solid #eaeaea;
    border-radius: 12px;
    background: #ffffff;
  }
  .pdf-tabs { border-bottom: 1px solid #eaeaea; background: #fbfbfa; }
  .pdf-tab-list { display: flex; flex-wrap: wrap; overflow-x: auto; }
  
  .pdf-tab-btn {
    position: relative;
    border: 0;
    border-right: 1px solid #eaeaea;
    background: transparent;
    color: #787774;
    padding: 1rem 1.2rem;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 650;
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms ease, background 200ms ease;
    outline: none;
  }
  .pdf-tab-btn:hover { color: #111111; background: #ffffff; }
  .pdf-tab-btn.active { color: #111111; background: #ffffff; box-shadow: inset 0 -1px 0 #111111; }
  
  .pdf-tab-btn:focus {
    outline: 2px solid rgba(17,17,17,0.3);
    outline-offset: -2px;
  }

  .pdf-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem;
    border-bottom: 1px solid #eaeaea;
    background: #fbfbfa;
  }
  .pdf-panel-header h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: #111111;
    font-size: 1rem;
    font-weight: 700;
  }
  .pdf-panel-header h3 svg { color: #9f2f2d; }
  .pdf-panel-header p { margin: 0.3rem 0 0; color: #787774; font-size: 0.88rem; }
  .pdf-open-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 6px;
    background: #111111;
    color: #ffffff;
    padding: 0.58rem 0.75rem;
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .pdf-open-link:hover { background: #333333; }
  .pdf-iframe-wrapper { padding: 1rem; }
  
  .pdf-preview-panel {
    display: none;
  }
  
  .pdf-preview-panel.active {
    display: block;
  }
  
  .pdf-iframe-wrapper iframe {
    width: 100%;
    min-height: 500px;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    background: #fbfbfa;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  
  .pdf-iframe-wrapper iframe[src] {
    opacity: 1;
  }
  .pdf-error-card {
    margin-bottom: 1.5rem;
    border: 1px solid rgba(159,47,45,0.24);
    border-radius: 12px;
    background: #fdebec;
    padding: 1rem;
    color: #9f2f2d;
  }
  .pdf-error-content { display: flex; align-items: flex-start; gap: 0.75rem; }
  .pdf-error-card h3 { margin: 0; font-size: 1rem; font-weight: 700; }
  .pdf-error-card p { margin: 0.3rem 0 0; line-height: 1.55; }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .pdf-iframe-wrapper iframe {
      height: 400px;
      min-height: 400px;
    }
    
    .pdf-tab-btn {
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
    }
  }
</style>
