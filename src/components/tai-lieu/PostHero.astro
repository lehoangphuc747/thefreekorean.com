---
export interface Props {
  cover?: string;
  title: string;
  description?: string;
  category?: string;
  subcategory?: string;
  class?: string;
}

const { cover, title, description, category, subcategory, class: className = '' } = Astro.props;
---

<section class={`post-hero ${className}`}>
  {cover && <img src={cover} alt={title} loading="lazy" />}
  <div class="post-copy">
    {(category || subcategory) && (
      <div class="badge-row">
        {category && <span class="badge category">{category}</span>}
        {subcategory && <span class="badge subcategory">{subcategory}</span>}
      </div>
    )}
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    <button id="scroll-to-download-btn" class="download-cta" type="button">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0-3-3m3 3 3-3M3 17V7a2 2 0 0 1 2-2h6l2 2h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
      </svg>
      Tải xuống
    </button>
  </div>
</section>

<style>
  .post-hero {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    border: 1px solid #eaeaea;
    border-radius: 12px;
    background: #ffffff;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .post-hero img {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid #eaeaea;
    border-radius: 10px;
    filter: saturate(0.86) contrast(0.96);
  }
  .badge-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .badge {
    display: inline-flex;
    border-radius: 9999px;
    padding: 0.32rem 0.62rem;
    font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .badge.category { background: #edf3ec; color: #346538; }
  .badge.subcategory { background: #fbf3db; color: #956400; }
  h1 { margin: 0; color: #111111; font-size: clamp(2rem, 4.5vw, 3.8rem); font-weight: 720; letter-spacing: -0.05em; line-height: 1.02; }
  p { max-width: 680px; margin: 1rem 0 0; color: #2f3437; line-height: 1.68; }
  .download-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    border: 0;
    border-radius: 6px;
    background: #111111;
    color: #ffffff;
    padding: 0.72rem 0.95rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
  }
  .download-cta:hover { background: #333333; }
  .download-cta:active { transform: scale(0.98); }
  @media (max-width: 720px) { .post-hero { grid-template-columns: 1fr; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const scrollBtn = document.getElementById('scroll-to-download-btn');
    if (!scrollBtn) return;
    scrollBtn.addEventListener('click', function() {
      const downloadSection = document.getElementById('download-section');
      if (downloadSection) downloadSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
