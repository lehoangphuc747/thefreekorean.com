---
export interface Props {
  lessons: Array<{
    number: number;
    title: string;
    cards: number;
    fileSize: string;
    downloadUrl: string;
    date: string;
  }>;
}

const { lessons } = Astro.props;
---

<section class="anki-lessons">
  <div class="lessons-header">
    <h2>Danh sách bài học</h2>
    <p>{lessons.length} bài học có thể tải riêng.</p>
  </div>

  <div class="lessons-grid">
    {lessons.map((lesson) => (
      <article class="lesson-card">
        <div class="lesson-topline">
          <span>Bài {lesson.number}</span>
          <small>{lesson.fileSize}</small>
        </div>
        <h3>{lesson.title}</h3>
        <div class="lesson-meta">
          <span>{lesson.cards} thẻ</span>
          <span>{lesson.date}</span>
        </div>
        <a href={lesson.downloadUrl} target="_blank" rel="noopener noreferrer" class="lesson-download">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0-3-3m3 3 3-3m2 8H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414A1 1 0 0 1 18 9.414V19a2 2 0 0 1-2 2Z" />
          </svg>
          Tải về
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .anki-lessons { border: 1px solid #eaeaea; border-radius: 12px; background: #ffffff; padding: 1.25rem; }
  .lessons-header { margin-bottom: 1rem; }
  h2 { margin: 0; color: #111111; font-size: 1.25rem; font-weight: 720; letter-spacing: -0.03em; }
  p { margin: 0.4rem 0 0; color: #787774; }
  .lessons-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .lesson-card { display: flex; flex-direction: column; min-height: 190px; border: 1px solid #eaeaea; border-radius: 10px; background: #fbfbfa; padding: 1rem; transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease; }
  .lesson-card:hover { border-color: rgba(0,0,0,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.04); transform: translateY(-1px); }
  .lesson-topline { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; color: #787774; font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  h3 { margin: 1rem 0 0; color: #111111; font-size: 1.08rem; line-height: 1.2; letter-spacing: -0.03em; }
  .lesson-meta { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: auto 0 1rem; padding-top: 1rem; }
  .lesson-meta span { display: inline-flex; border-radius: 9999px; background: #fbf3db; color: #956400; padding: 0.26rem 0.52rem; font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace; font-size: 0.66rem; font-weight: 700; }
  .lesson-download { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; border-radius: 6px; background: #111111; color: #ffffff; padding: 0.62rem 0.75rem; text-decoration: none; font-size: 0.84rem; font-weight: 700; transition: background 200ms ease, transform 200ms ease; }
  .lesson-download:hover { background: #333333; }
  .lesson-download:active { transform: scale(0.98); }
  @media (max-width: 980px) { .lessons-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .lessons-grid { grid-template-columns: 1fr; } }
</style>
