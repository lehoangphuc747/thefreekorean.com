---
export interface Props {
  documents: Array<{
    title: string;
    category: string;
    subcategory?: string;
    type: string;
    description: string;
    pages?: number;
    cards?: number;
    fileSize?: string;
    url: string;
    slug: string;
    date: string;
  }>;
  class?: string;
}

const { documents, class: className = '' } = Astro.props;
const categories = [...new Set(documents.map(doc => doc.category).filter(Boolean))];
const subcategoriesByCategory = categories.reduce((acc, category) => {
  acc[category] = [...new Set(documents
    .filter(doc => doc.category === category && doc.subcategory)
    .map(doc => doc.subcategory)
    .filter(Boolean)
  )];
  return acc;
}, {} as Record<string, string[]>);

const getDocumentCount = (category?: string) => {
  if (!category) return documents.length;
  return documents.filter(doc => doc.category === category).length;
};
---

<section class={`document-filter reveal-block ${className}`} aria-label="Bộ lọc tài liệu">
  <div class="filter-panel">
    <div class="filter-header">
      <div>
        <h2>Lọc tài liệu</h2>
        <p>Tìm theo danh mục, nhóm tài liệu hoặc tên sách.</p>
      </div>
      <div class="results-count" id="results-count">
        <strong>{documents.length}</strong>
        <span>tài liệu</span>
      </div>
    </div>

    <div class="filter-section" aria-label="Danh mục chính">
      <button type="button" class="filter-btn category-filter active" data-category="">
        <span>Tất cả</span>
        <small>{getDocumentCount()}</small>
      </button>

      {categories.map(category => (
        <button type="button" class="filter-btn category-filter" data-category={category}>
          <span>{category}</span>
          <small>{getDocumentCount(category)}</small>
        </button>
      ))}
    </div>

    <div class="filter-section subcategory-row" id="subcategory-filters" aria-label="Danh mục phụ">
      <button type="button" class="filter-btn subcategory-filter active" data-subcategory="">
        Tất cả nhóm
      </button>
    </div>

    <div class="search-row">
      <label for="document-search">Tìm kiếm tài liệu</label>
      <div class="search-field">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
        </svg>
        <input id="document-search" type="text" placeholder="Nhập tên giáo trình hoặc bộ thẻ" />
      </div>
    </div>

    <div class="filter-footer">
      <div id="active-filter-chips" class="active-filter-chips" aria-live="polite"></div>
      <button type="button" id="clear-filters" class="clear-filters hidden">
        Xóa bộ lọc
      </button>
    </div>
  </div>
</section>

<script define:vars={{ subcategoriesByCategory }}>
document.addEventListener('DOMContentLoaded', function() {
  const categoryButtons = document.querySelectorAll('.category-filter');
  const searchInput = document.getElementById('document-search');
  const resultsCount = document.getElementById('results-count');
  const subcategoryContainer = document.getElementById('subcategory-filters');
  const clearFiltersBtn = document.getElementById('clear-filters');
  const activeFilterChips = document.getElementById('active-filter-chips');

  let currentCategory = '';
  let currentSubcategory = '';
  let currentSearch = '';

  function setActive(buttons, activeButton) {
    buttons.forEach((btn) => btn.classList.remove('active'));
    activeButton.classList.add('active');
  }

  function bindSubcategoryButton(button) {
    button.addEventListener('click', function() {
      handleSubcategoryFilter(this);
    });
  }

  function updateSubcategoryButtons(selectedCategory) {
    subcategoryContainer.innerHTML = '';
    const allButton = document.createElement('button');
    allButton.type = 'button';
    allButton.className = 'filter-btn subcategory-filter active';
    allButton.setAttribute('data-subcategory', '');
    allButton.textContent = 'Tất cả nhóm';
    bindSubcategoryButton(allButton);
    subcategoryContainer.appendChild(allButton);
    currentSubcategory = '';

    if (selectedCategory && subcategoriesByCategory[selectedCategory]) {
      subcategoriesByCategory[selectedCategory].forEach((subcategory) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'filter-btn subcategory-filter';
        button.setAttribute('data-subcategory', subcategory);
        button.textContent = subcategory;
        bindSubcategoryButton(button);
        subcategoryContainer.appendChild(button);
      });
    }
  }

  function handleCategoryFilter(button) {
    setActive(categoryButtons, button);
    currentCategory = button.getAttribute('data-category') || '';
    updateSubcategoryButtons(currentCategory);
    filterDocuments();
  }

  function handleSubcategoryFilter(button) {
    const buttons = document.querySelectorAll('.subcategory-filter');
    setActive(buttons, button);
    currentSubcategory = button.getAttribute('data-subcategory') || '';
    filterDocuments();
  }

  function updateActiveFilterChips() {
    if (!activeFilterChips) return;
    activeFilterChips.innerHTML = '';

    const chips = [
      currentCategory && { label: currentCategory, type: 'category' },
      currentSubcategory && { label: currentSubcategory, type: 'subcategory' },
      currentSearch && { label: `"${currentSearch}"`, type: 'search' },
    ].filter(Boolean);

    chips.forEach((chip) => {
      const element = document.createElement('button');
      element.type = 'button';
      element.className = `active-chip ${chip.type}`;
      element.setAttribute('data-type', chip.type);
      element.innerHTML = `<span>${chip.label}</span><span aria-hidden="true">×</span>`;
      element.addEventListener('click', function() {
        const type = this.getAttribute('data-type');
        if (type === 'category') {
          const allCategoryBtn = document.querySelector('[data-category=""]');
          if (allCategoryBtn) handleCategoryFilter(allCategoryBtn);
        } else if (type === 'subcategory') {
          const allSubcategoryBtn = document.querySelector('[data-subcategory=""]');
          if (allSubcategoryBtn) handleSubcategoryFilter(allSubcategoryBtn);
        } else if (type === 'search') {
          clearSearch();
        }
      });
      activeFilterChips.appendChild(element);
    });
  }

  function filterDocuments() {
    const documentCards = document.querySelectorAll('.document-card-wrapper');
    let visibleCount = 0;

    documentCards.forEach((card) => {
      const cardCategory = card.getAttribute('data-category');
      const cardSubcategory = card.getAttribute('data-subcategory');
      const cardTitle = card.getAttribute('data-title')?.toLowerCase() || '';
      const matchesCategory = !currentCategory || cardCategory === currentCategory;
      const matchesSubcategory = !currentSubcategory || cardSubcategory === currentSubcategory;
      const matchesSearch = !currentSearch || cardTitle.includes(currentSearch.toLowerCase());
      const isVisible = matchesCategory && matchesSubcategory && matchesSearch;

      card.style.display = isVisible ? 'block' : 'none';
      if (isVisible) visibleCount++;
    });

    if (resultsCount) {
      resultsCount.innerHTML = `<strong>${visibleCount}</strong><span>tài liệu</span>`;
    }

    updateActiveFilterChips();

    const hasActiveFilters = currentCategory || currentSubcategory || currentSearch;
    if (clearFiltersBtn) clearFiltersBtn.classList.toggle('hidden', !hasActiveFilters);
  }

  function clearSearch() {
    if (searchInput) searchInput.value = '';
    currentSearch = '';
    filterDocuments();
  }

  function clearAllFilters() {
    const allCategoryBtn = document.querySelector('[data-category=""]');
    if (allCategoryBtn) setActive(categoryButtons, allCategoryBtn);
    currentCategory = '';
    updateSubcategoryButtons('');
    clearSearch();
    filterDocuments();
  }

  categoryButtons.forEach((button) => {
    button.addEventListener('click', function() {
      handleCategoryFilter(this);
    });
  });

  if (clearFiltersBtn) {
    clearFiltersBtn.addEventListener('click', clearAllFilters);
  }

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      currentSearch = this.value.trim();
      filterDocuments();
    });
  }

  updateSubcategoryButtons('');
});
</script>

<style is:global>
  .document-filter {
    margin: 0 0 1.25rem;
  }

  .filter-panel {
    border: 1px solid #eaeaea;
    border-radius: 12px;
    background: rgba(255,255,255,0.9);
    padding: 1.25rem;
  }

  .filter-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eaeaea;
  }

  .filter-header h2 {
    margin: 0;
    color: #111111;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .filter-header p {
    margin: 0.35rem 0 0;
    color: #787774;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .results-count {
    display: grid;
    min-width: 96px;
    gap: 0.1rem;
    text-align: right;
  }

  .results-count strong {
    color: #111111;
    font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace;
    font-size: 1rem;
  }

  .results-count span {
    color: #787774;
    font-size: 0.72rem;
  }

  .filter-section {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1rem;
  }

  .subcategory-row {
    padding-top: 0.7rem;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    background: #ffffff;
    color: #787774;
    padding: 0.55rem 0.72rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 200ms ease, background 200ms ease, color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .filter-btn small {
    color: inherit;
    font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    opacity: 0.78;
  }

  .filter-btn:hover {
    border-color: rgba(0,0,0,0.2);
    color: #111111;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .filter-btn:active { transform: scale(0.98); }

  .filter-btn.active {
    border-color: #111111;
    background: #111111;
    color: #ffffff;
  }

  .subcategory-filter.active {
    border-color: #eaeaea;
    background: #edf3ec;
    color: #346538;
  }

  .search-row {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
  }

  .search-row label {
    color: #787774;
    font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-field svg {
    position: absolute;
    left: 0.9rem;
    color: #787774;
    pointer-events: none;
  }

  #document-search {
    width: 100%;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    background: #fbfbfa;
    color: #111111;
    padding: 0.9rem 1rem 0.9rem 2.6rem;
    font: inherit;
    font-size: 0.92rem;
    transition: border-color 200ms ease, background 200ms ease;
  }

  #document-search::placeholder { color: #9b9a97; }

  #document-search:focus {
    outline: none;
    border-color: #111111;
    background: #ffffff;
  }

  .filter-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2rem;
    padding-top: 1rem;
  }

  .active-filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .active-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #eaeaea;
    border-radius: 9999px;
    background: #fbf3db;
    color: #956400;
    padding: 0.32rem 0.62rem;
    font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .active-chip.subcategory { background: #e1f3fe; color: #1f6c9f; }
  .active-chip.search { background: #fdebec; color: #9f2f2d; }

  .clear-filters {
    flex: 0 0 auto;
    border: 1px solid #eaeaea;
    border-radius: 6px;
    background: #ffffff;
    color: #9f2f2d;
    padding: 0.5rem 0.7rem;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .clear-filters:hover { border-color: rgba(159,47,45,0.32); }
  .clear-filters:active { transform: scale(0.98); }
  .hidden { display: none; }

  @media (max-width: 640px) {
    .filter-panel { padding: 1rem; }
    .filter-header,
    .filter-footer {
      display: grid;
      text-align: left;
    }
    .results-count { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-btn,
    .clear-filters,
    #document-search {
      transition: none;
    }
  }
</style>
