---
export interface Props {
  title: string;
  description: string;
  cover: string;
  type: string;
  category: string;
  subcategory: string;
  pages?: number;
  fileSize: string;
  class?: string;
}

const { title, description, cover, type, category, subcategory, pages, fileSize, class: className = '' } = Astro.props;
---

<section class={`textbooks-header ${className}`}>
  <div class="detail-card">
    <div class="cover-column">
      <a href="/tai-lieu" class="back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Quay lại
      </a>
      <img src={cover} alt={title} class="book-cover" loading="lazy" />
    </div>

    <div class="content-column">
      <span class="type-badge">{type}</span>
      <h1>{title}</h1>
      <p>{description}</p>

      <div class="detail-panel" aria-label="Thông tin chi tiết">
        <h2>Thông tin chi tiết</h2>
        <dl>
          <div><dt>Danh mục</dt><dd>{category}</dd></div>
          <div><dt>Phân loại</dt><dd>{subcategory}</dd></div>
          {pages && <div><dt>Số trang</dt><dd>{pages} trang</dd></div>}
          <div><dt>Kích thước</dt><dd>{fileSize}</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .textbooks-header { margin-bottom: 1.5rem; }
  .detail-card {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 2rem;
    border: 1px solid #eaeaea;
    border-radius: 12px;
    background: #ffffff;
    padding: 1.5rem;
  }
  .cover-column { display: grid; gap: 1rem; align-content: start; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    border: 1px solid #eaeaea;
    border-radius: 6px;
    background: #ffffff;
    color: #787774;
    padding: 0.45rem 0.65rem;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 650;
  }
  .back-link:hover { color: #111111; border-color: rgba(0,0,0,0.2); }
  .book-cover {
    width: 100%;
    max-width: 260px;
    height: auto;
    border: 1px solid #eaeaea;
    border-radius: 10px;
    filter: saturate(0.86) contrast(0.96);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .book-cover:hover { transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .content-column { min-width: 0; }
  .type-badge {
    display: inline-flex;
    border-radius: 9999px;
    background: #e1f3fe;
    color: #1f6c9f;
    padding: 0.32rem 0.62rem;
    font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  h1 {
    margin: 1rem 0 0;
    color: #111111;
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    font-weight: 720;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }
  p {
    max-width: 680px;
    margin: 1rem 0 0;
    color: #2f3437;
    font-size: 1rem;
    line-height: 1.68;
  }
  .detail-panel {
    margin-top: 1.5rem;
    border: 1px solid #eaeaea;
    border-radius: 10px;
    background: #fbfbfa;
    padding: 1rem;
  }
  .detail-panel h2 {
    margin: 0 0 0.8rem;
    color: #111111;
    font-size: 0.95rem;
    font-weight: 700;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    margin: 0;
  }
  dl div { display: grid; gap: 0.25rem; }
  dt {
    color: #787774;
    font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  dd { margin: 0; color: #111111; font-weight: 650; }
  @media (max-width: 760px) {
    .detail-card { grid-template-columns: 1fr; padding: 1rem; }
    .book-cover { max-width: 220px; }
    dl { grid-template-columns: 1fr; }
  }
</style>
