---
export interface Props {
  downloadUrl: string;
  downloadOriginal?: string;
  downloadWorkbook?: string;
  downloadAudio?: string;
  downloadAnki?: string;
  fileSize: string;
  originalSize?: string;
  workbookSize?: string;
  audioSize?: string;
}

const { downloadUrl, downloadOriginal, downloadWorkbook, downloadAudio, downloadAnki, fileSize, originalSize, workbookSize, audioSize } = Astro.props;

const icons = {
  book: `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
  hd: `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16 2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3Z" /></svg>`,
  workbook: `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.414-9.414a2 2 0 1 1 2.828 2.828L11.828 15H9v-2.828l8.586-8.586Z" /></svg>`,
  audio: `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.536 8.464a5 5 0 0 1 0 7.072m2.828-9.9a9 9 0 0 1 0 12.728M5.586 15H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15Z" /></svg>`,
  anki: `<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414A1 1 0 0 1 18 9.414V19a2 2 0 0 1-2 2Z" /></svg>`,
};

const downloadItems = [{ href: downloadUrl, label: 'Giáo trình chính', size: fileSize, icon: icons.book }];
if (downloadOriginal && originalSize) downloadItems.push({ href: downloadOriginal, label: 'Bản gốc HD', size: originalSize, icon: icons.hd });
if (downloadWorkbook && workbookSize) downloadItems.push({ href: downloadWorkbook, label: 'Sách bài tập', size: workbookSize, icon: icons.workbook });
if (downloadAudio && audioSize) downloadItems.push({ href: downloadAudio, label: 'File audio', size: audioSize, icon: icons.audio });
if (downloadAnki) downloadItems.push({ href: downloadAnki, label: 'Bộ thẻ Anki', size: '1,584 thẻ', icon: icons.anki });
---

<section class="download-panel" id="download-section">
  <div class="download-header">
    <h2>Tải xuống tài liệu</h2>
    <p>Chọn phiên bản tài liệu bạn cần.</p>
  </div>

  <div class="download-grid">
    {downloadItems.map((item) => (
      <a href={item.href} class="download-btn" target="_blank" rel="noopener noreferrer">
        <span class="download-icon" set:html={item.icon} />
        <span class="download-copy">
          <strong>{item.label}</strong>
          <small>{item.size}</small>
        </span>
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1m-4-4-4 4m0 0-4-4m4 4V4" />
        </svg>
      </a>
    ))}
  </div>
</section>

<style>
  .download-panel { margin-bottom: 1.5rem; border: 1px solid #eaeaea; border-radius: 12px; background: #ffffff; padding: 1.25rem; }
  .download-header { margin-bottom: 1rem; }
  h2 { margin: 0; color: #111111; font-size: 1.25rem; font-weight: 720; letter-spacing: -0.03em; }
  p { margin: 0.4rem 0 0; color: #787774; line-height: 1.6; }
  .download-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .download-btn { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.8rem; border: 1px solid #eaeaea; border-radius: 10px; background: #fbfbfa; color: #111111; padding: 0.9rem; text-decoration: none; transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease; }
  .download-btn:hover { border-color: rgba(0,0,0,0.22); box-shadow: 0 2px 8px rgba(0,0,0,0.04); transform: translateY(-1px); }
  .download-btn:active { transform: scale(0.99); }
  .download-icon { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 1px solid #eaeaea; border-radius: 8px; background: #edf3ec; color: #346538; }
  .download-copy { display: grid; gap: 0.2rem; }
  .download-copy strong { font-size: 0.92rem; }
  .download-copy small { color: #787774; font-family: 'Geist Mono', 'SF Mono', 'JetBrains Mono', monospace; font-size: 0.7rem; }
  @media (max-width: 720px) { .download-grid { grid-template-columns: 1fr; } }
</style>
