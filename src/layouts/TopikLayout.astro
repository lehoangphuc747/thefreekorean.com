---
// TOPIK Layout - Layout riêng cho trang TOPIK
import Layout from './Layout.astro';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  showBackButton?: boolean;
  showNavigation?: boolean;
  class?: string;
}

const { 
  title = 'TOPIK', 
  description = 'Luyện thi TOPIK - Test of Proficiency in Korean',
  keywords = ['TOPIK', 'luyện thi TOPIK', 'tiếng Hàn', '한국어능력시험'],
  image,
  showBackButton = true,
  showNavigation = true,
  class: className = ''
} = Astro.props;

const fullTitle = title === 'TOPIK' ? 'TOPIK - The Free Korean' : `${title} - TOPIK - The Free Korean`;
---

<Layout title={fullTitle} description={description} keywords={keywords} image={image}>
  <div class={`topik-layout min-h-screen ${className}`}>
    
    <!-- TOPIK Content -->
    <main class="flex-1">
      <slot />
    </main>
  </div>
</Layout>


<style>
  /* TOPIK specific styles */
  .topik-layout {
    background: #f7f6f3;
    font-family: 'SF Pro Display', 'Geist Sans', 'Helvetica Neue', 'Switzer', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  
  /* Smooth transitions for all interactive elements */
  .topik-layout a,
  .topik-layout button {
    transition: all 0.2s ease;
  }
  
  /* Custom scrollbar for TOPIK pages */
  .topik-layout ::-webkit-scrollbar {
    width: 8px;
  }
  
  .topik-layout ::-webkit-scrollbar-track {
    background: #f7f6f3;
  }
  
  .topik-layout ::-webkit-scrollbar-thumb {
    background: #c9c7c1;
    border-radius: 4px;
  }
  
  .topik-layout ::-webkit-scrollbar-thumb:hover {
    background: #787774;
  }
</style>
