---
export const prerender = true;
import TopikLayout from '../../../layouts/TopikLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const exams = await getCollection('thi-thu');
  return exams.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const exam = entry.data;
const slug = entry.id;
---

<TopikLayout 
  title={exam.meta.title}
  description={exam.meta.description || `Thi thử TOPIK - ${exam.meta.title}`}
>
  <div class="exam-overview-root">
    <div class="overview-container">
      
      <!-- Back button -->
      <a href="/topik/thi-thu" class="back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Trở về danh sách
      </a>

      <!-- Exam Header -->
      <header class="overview-header">
        <h1 class="exam-title">{exam.meta.title}</h1>
        <div class="exam-meta">
          <span class="meta-badge">{exam.meta.level}</span>
          <span class="meta-item">{exam.meta.totalQuestions} câu hỏi</span>
          <span class="meta-dot">·</span>
          <span class="meta-item">{exam.meta.duration} phút</span>
        </div>
        {exam.meta.description && <p class="exam-desc">{exam.meta.description}</p>}
      </header>

      <!-- Section Cards -->
      <div class="sections-grid">
        
        <!-- Listening -->
        <a href={`/topik/thi-thu/${slug}/listening`} class="section-card">
          <div class="section-card-inner">
            <div class="section-icon">🎧</div>
            <div class="section-info">
              <h2 class="section-title">듣기 · Listening</h2>
              <p class="section-stats">50 câu · 60 phút</p>
            </div>
            <div class="section-action">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>

        <!-- Reading -->
        <a href={`/topik/thi-thu/${slug}/reading`} class="section-card">
          <div class="section-card-inner">
            <div class="section-icon">📖</div>
            <div class="section-info">
              <h2 class="section-title">읽기 · Reading</h2>
              <p class="section-stats">50 câu · 50 phút</p>
            </div>
            <div class="section-action">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>

        <!-- Writing -->
        <a href={`/topik/thi-thu/${slug}/writing`} class="section-card">
          <div class="section-card-inner">
            <div class="section-icon">✍️</div>
            <div class="section-info">
              <h2 class="section-title">쓰기 · Writing</h2>
              <p class="section-stats">4 câu · 50 phút</p>
            </div>
            <div class="section-action">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>

      </div>
      
    </div>
  </div>
</TopikLayout>

<style>
/* ── Root layout ─────────────────────────────── */
.exam-overview-root {
  min-height: 100vh;
  background: #f8f7f5;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  padding: 3rem 1.5rem;
}

.overview-container {
  max-width: 640px;
  margin: 0 auto;
}

/* ── Back Link ───────────────────────────────── */
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  color: #888;
  text-decoration: none;
  margin-bottom: 2.5rem;
  transition: color 0.15s;
}
.back-link:hover { color: #1a1a1a; }

/* ── Header ──────────────────────────────────── */
.overview-header {
  margin-bottom: 3rem;
}
.exam-title {
  font-size: 2rem;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.02em;
  margin: 0 0 1rem;
}
.exam-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.75rem;
  font-size: 0.875rem;
  color: #666;
}
.meta-badge {
  background: #1a1a1a;
  color: #fff;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-weight: 600;
  font-size: 0.75rem;
  letter-spacing: 0.02em;
}
.meta-dot { color: #ccc; }
.exam-desc {
  margin-top: 1.25rem;
  font-size: 0.95rem;
  line-height: 1.6;
  color: #555;
}

/* ── Sections Grid ───────────────────────────── */
.sections-grid {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.section-card {
  display: block;
  text-decoration: none;
  background: #ffffff;
  border: 1px solid #e8e6e1;
  border-radius: 12px;
  transition: border-color 0.15s, background 0.15s, transform 0.15s;
}
.section-card:hover {
  border-color: #ccc;
  background: #fafaf9;
  transform: translateY(-2px);
}

.section-card-inner {
  display: flex;
  align-items: center;
  padding: 1.5rem;
  gap: 1.25rem;
}

.section-icon {
  font-size: 1.75rem;
  width: 3.5rem;
  height: 3.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f2ef;
  border-radius: 10px;
}

.section-info {
  flex: 1;
}

.section-title {
  font-size: 1.1rem;
  font-weight: 600;
  color: #1a1a1a;
  margin: 0 0 0.25rem;
}

.section-stats {
  font-size: 0.85rem;
  color: #888;
  margin: 0;
}

.section-action {
  color: #ccc;
  transition: color 0.15s;
}
.section-card:hover .section-action {
  color: #1a1a1a;
}
</style>
